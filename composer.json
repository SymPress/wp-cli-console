{
    "name": "sympress/wp-cli-console",
    "description": "Symfony Console wrappers for useful WP-CLI workflows.",
    "type": "wordpress-muplugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schäffner",
            "email": "brian.schaeffner@sympress.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "sympress/kernel": "^1.1.1",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "sympress/qa": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\WpCliConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\WpCliConsole\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "qa static-analysis"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "qa tests"
        ],
        "test": [
            "@tests"
        ],
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "kernel": {
            "bundle": "SymPress\\WpCliConsole\\WpCliConsoleBundle",
            "entry": "wp-cli-console/wp-cli-console.php"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
