{
    "name": "sympress/wp-cli-console",
    "description": "Symfony Console wrappers for useful WP-CLI workflows.",
    "type": "wordpress-muplugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schäffner",
            "email": "brian.schaeffner@sympress.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "sympress/kernel": "dev-main",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "sympress/coding-standards": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\WpCliConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\WpCliConsole\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php cs"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php static-analysis"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/package-quality.php tests"
        ],
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "kernel": {
            "bundle": "SymPress\\WpCliConsole\\WpCliConsoleBundle",
            "entry": "wp-cli-console/wp-cli-console.php"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
